# Servidor HTTP. O TLS termina no Traefik do Coolify, nada de TLS no app.
MCP_PORT=3000
MCP_HOST=0.0.0.0

# Bearer token exigido em /mcp. Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=

# PAT do GitHub (scope: public_repo ou repo). Opcional até a Fase 3.
GITHUB_TOKEN=

# Diretórios montados como volume no Coolify.
CAREER_DATA_DIR=/app/data
CAREER_OUTPUT_DIR=/app/output

# Cache do GitHub. Descartável: apagar só custa um sync_github novo.
CAREER_CACHE_DIR=/app/cache
